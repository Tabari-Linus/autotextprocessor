<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"  xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lii.autotexttprocessor.controller.DataManagementController">

    <HBox spacing="10">
        <TextField fx:id="idField" promptText="ID" prefWidth="80"/>
        <TextField fx:id="nameField" promptText="Name" prefWidth="150"/>
        <TextField fx:id="valueField" promptText="Value" prefWidth="150"/>
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </HBox>

    <TableView fx:id="entryTableView" prefHeight="300">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
            <TableColumn fx:id="valueColumn" text="Value" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
